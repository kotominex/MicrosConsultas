# Copiar este archivo a ".env" antes de levantar el stack.
# docker-compose.yml lee estas variables automaticamente.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Conexion de auth-service/core-service a PostgreSQL ---
# Host y puerto son compartidos por ambos servicios (una sola instancia de Postgres).
# Solo hace falta cambiarlos si Postgres corre fuera de la red de docker-compose.
DB_HOST=postgres
DB_PORT=5432
# Nombre de base por servicio (ver ARQUITECTURA.md, seccion 2.5 - database-per-service).
AUTH_DB_NAME=auth_db
CORE_DB_NAME=core_db

# --- Seguridad (JWT) ---
# Secreto compartido entre auth-service (emisor) y core-service (validador).
# Cambiar por un valor propio y no versionarlo en produccion.
JWT_SECRET=change-me-super-secret-key-for-jwt-signing-please
JWT_EXPIRATION_MS=3600000

# --- Puertos expuestos al host ---
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
CORE_SERVICE_PORT=8082
FRONTEND_PORT=4200

# --- CORS (api-gateway) ---
# Origen permitido para las peticiones del frontend Angular.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Scheduler ---
SCHEDULER_OVERDUE_CRON=0 0 * * * *
